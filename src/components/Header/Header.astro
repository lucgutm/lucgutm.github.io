---
const { pathname } = Astro.url;
const isPosts = pathname === '/' || pathname.startsWith('/posts/');
const isAbout = pathname.startsWith('/about');
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href="/">Blog</a>
    <nav class="header__nav" aria-label="Main navigation">
      <a
        class:list={['header__link', { 'header__link--active': isPosts }]}
        href="/"
        >Posts</a
      >
      <a
        class:list={['header__link', { 'header__link--active': isAbout }]}
        href="/about"
        >About</a
      >
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--surface-bg);
    border-bottom: 1px solid var(--surface-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
  }

  .header__brand {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .header__brand:hover {
    color: var(--brand-cyan);
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header__link {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .header__link:hover {
    color: var(--brand-cyan);
  }

  .header__link--active {
    color: var(--brand-cyan);
    font-weight: 700;
  }

  @media (max-width: 420px) {
    .header__inner {
      gap: 0.75rem;
      padding-block: 0.75rem;
    }

    .header__nav {
      gap: 1rem;
    }

    .header__brand {
      font-size: 1.25rem;
    }

    .header__link {
      font-size: 0.9375rem;
    }
  }
</style>
